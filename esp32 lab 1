void setup() {
  pinMode(25, OUTPUT);
  pinMode(26, OUTPUT);
  pinMode(27, OUTPUT);

 
  pinMode(4, INPUT_PULLUP);
}

void loop() {
  digitalWrite(25, HIGH);
  delay(500);
  digitalWrite(25, LOW);
  delay(500);

  digitalWrite(26, HIGH);
  delay(500);
  digitalWrite(26, LOW);
  delay(500);

 
  if (digitalRead(4) == LOW) {
    digitalWrite(27, HIGH);
  } else {
    digitalWrite(27, LOW);
  }
}
